# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Admin account seeded on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# SQLite database (file path relative to project root)
DATABASE_URL="file:./reach.db"

# --- Remote access (Tailscale) ---
# Reach binds 127.0.0.1 and is published over the tailnet with:
#   sudo tailscale serve --bg --https=8444 http://127.0.0.1:3000
#   -> https://<host>.<tailnet>.ts.net:8444
# Serve, never Funnel: /console hands out a real PTY, so this must stay
# tailnet-only. (Port 8444 because 8443 is already nginx on this box.)
# Admin routes (/console, /files, /admin, the terminal WebSocket) additionally
# require the request to carry an approved Tailscale identity, so a leaked
# reach password alone can't reach a shell. Comma-separated tailnet logins;
# empty or unset disables the check. Find yours with `tailscale status --json`.
# Read in edge middleware, so changes need a rebuild (`npm run deploy`).
# Note: tagged devices carry no user identity and are rejected by design.
# REACH_TAILNET_ADMIN_LOGINS=you@github

# --- Files (admin file drop) ---
# Dedicated, writable uploads root (created on demand). Defaults to ~/uploads.
# REACH_UPLOADS_DIR=/home/regan/uploads
# Base path for discovered apps; also exposed as the writable "Apps" root.
# APPS_BASE_PATH=/home/regan/apps
# Optional extra roots: comma-separated `id:Label:/abs/path[:ro]` (`:ro` = read-only).
# REACH_FILE_ROOTS=media:Media:/srv/media,backups:Backups:/srv/backups:ro
