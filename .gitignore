############################
# Database
############################
# The SQLite file holds real user rows, including bcrypt password hashes.
# It is generated by `npm run db:push` + `npm run db:seed`, so it never
# belongs in a repo — least of all a public one.
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

