{
  "name": "reach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=3001 tsx watch server.ts",
    "build": "next build",
    "start": "sudo systemctl start reach",
    "stop": "sudo systemctl stop reach",
    "restart": "sudo systemctl restart reach",
    "deploy": "next build && sudo systemctl restart reach",
    "logs": "journalctl -u reach -f",
    "start:direct": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "0.468.0",
    "next": "15.3.0",
    "next-auth": "5.0.0-beta.25",
    "node-pty": "^1.1.0",
    "prisma": "6.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.5.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
