[Unit]
Description=Reach app portal (Next.js)
Documentation=https://github.com/regan/reach
After=network-online.target docker.service reach-tmux.service
Wants=network-online.target
# Persistent tmux server that backs the console terminals. Wants= (not
# Requires=/PartOf=) so restarting or stopping reach never takes the terminal
# server — and the running shells — down with it.
Wants=reach-tmux.service
# Stop restart-looping if the service can't come up (e.g. a partial .next/
# build). 10 attempts within 300s, then systemd marks the unit failed.
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
User=regan
Group=regan
WorkingDirectory=/home/regan/apps/reach
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=HOME=/home/regan
ExecStart=/home/regan/apps/reach/scripts/start-prod.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reach
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
